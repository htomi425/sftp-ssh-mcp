{
  "name": "ssh-mcp-cloudflare-oauth-validation",
  "private": true,
  "type": "module",
  "description": "Isolated validation of Cloudflare Workers OAuth Provider v1; never deployed automatically",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:provider": "node tests/provider-bundle-smoke.mjs",
    "check:workerd": "node tests/provider-workerd-smoke.mjs",
    "check:binding": "node tests/service-binding-workerd-smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
