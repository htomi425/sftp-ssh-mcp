{
  "name": "ssh-mcp-cloudflare-oauth-validation",
  "private": true,
  "type": "module",
  "description": "Isolated validation of Cloudflare Workers OAuth Provider v1; never deployed automatically",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:provider": "node tests/provider-bundle-smoke.mjs",
    "check:workerd": "node tests/provider-workerd-smoke.mjs",
    "check:binding": "node tests/service-binding-workerd-smoke.mjs",
    "check:provider-binding": "node tests/provider-binding-workerd-smoke.mjs",
    "check:real-oauth-binding": "node tests/real-oauth-binding-workerd-smoke.mjs",
    "check:real-oauth-pkce": "node tests/real-oauth-pkce-workerd-smoke.mjs && node tests/access-oauth-workerd-smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "esbuild": "0.25.12",
    "miniflare": "4.20260730.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1"
  }
}
